{
  "uid": "eks-hybrid-nodes",
  "title": "EKS Hybrid Nodes",
  "description": "The storm console: every query resolves against the LOCAL Prometheus. No panel depends on AWS - including the two that watch the cloud, which measure it from the on-prem side.",
  "tags": [
    "workshop",
    "eks-hybrid"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Cloud link, measured from the data center",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Cloud Reachability",
      "description": "Can my DC reach the EKS control plane right now? Measured FROM on-prem by the Blackbox Exporter.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-cloud-reachability\"}",
          "legendFormat": "EKS endpoint",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP \u2714",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN \u2718",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "wideLayout": false
      }
    },
    {
      "id": 2,
      "title": "Cloud Nodes Reachable",
      "description": "One tile per cloud node (ICMP from on-prem). During a disconnection, watch the cloud side of the fleet drop off node by node.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{group=\"cloud-nodes\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP \u2714",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN \u2718",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 9,
      "title": "Gateway Leader",
      "description": "Hybrid Nodes Gateway pods holding the leader lease (sum of hybrid_gateway_leader_is_active). Must read exactly 1. The gateway runs in the CLOUD and is scraped through the API server, so this tile goes blank during a total disconnection.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "sum(hybrid_gateway_leader_is_active) and on() (min(up{job=\"hybrid-gateway\"}) == 1)",
          "legendFormat": "leaders",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA (cloud side)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO LEADER \u2718",
                  "color": "red"
                },
                "1": {
                  "text": "1 LEADER \u2714",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 2,
                "to": 100,
                "result": {
                  "text": "SPLIT \u2718",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6e7079",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Data center",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Hybrid Node CPU",
      "description": "Are my servers healthy? node-exporter on each hybrid node.",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "100 - (avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "Hybrid Node Memory",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
    {
      "id": 8,
      "title": "Pods by Node",
      "description": "Where is everything running? From the LOCAL kube-state-metrics (its watch cache keeps serving during a disconnection).",
      "type": "table",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "count by (node) (kube_pod_info)",
          "legendFormat": "{{node}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "node": "Node",
              "Value": "Pods"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pods"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "max",
                "value": 40
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Inference service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 5,
      "title": "Inference Request Rate",
      "description": "Is the service being used? Requests hitting the on-prem inference pods. Keeps flowing during a disconnection - local demand does not care about the WAN.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(ollama_http_requests_total[2m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Inference Latency p95 (all tiers)",
      "description": "Is it fast enough? Request duration histogram from the metrics proxy. Aggregates EVERY pod, on-premises and cloud burst - so during a burst this reads lower than the panel to its right. That one is hybrid-only and is what KEDA scales on; compare the HPA against that, not this.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ollama_request_duration_seconds_bucket[2m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Inference p95, Hybrid Tier (KEDA signal)",
      "description": "The EXACT query KEDA scales on, threshold 1s - Module 6.4. p95 latency of the on-premises tier only: burst replicas are excluded on purpose, because counting them would lower the signal that triggered them and flap the scaler. Idle sits near 0.5s and the module 6.4 load pushes it past 1s, so the red line is the decision point. This panel used to plot the queue gauge (waiting/running), which cannot move while OLLAMA_NUM_PARALLEL is 2 and the load never exceeds 2 concurrent requests.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum(rate(ollama_request_duration_seconds_bucket{node_type=\"hybrid\"}[2m])) by (le)) >= 0) or (vector(0) and on() (count(ollama_request_duration_seconds_count{node_type=\"hybrid\"}) > 0))",
          "legendFormat": "p95 hybrid",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 3,
  "graphTooltip": 1,
  "editable": false,
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  }
}
